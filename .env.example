# ---------------------------------------------------------------------------
# docker2k8s-mcp configuration. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# LLM credentials. Only the bundled reference client (client/agent.py) needs
# these; the MCP server itself never calls an LLM. Leave blank when you drive
# the server from Claude Desktop, Claude Code, Cursor or any other MCP client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=

# Path to the kubectl binary used for applying manifests.
KUBECTL_PATH=kubectl

# Kubernetes context and default namespace. Leave KUBE_CONTEXT blank to use
# whatever kubectl currently has selected.
KUBE_CONTEXT=
KUBE_NAMESPACE=default

# Where generated manifests are written (one subdirectory per project).
GENERATED_DIR=./generated

# Directories the server may read projects from, separated by the OS path
# separator (';' on Windows, ':' elsewhere). Leave blank to allow the working
# directory and the project root only. This is the filesystem sandbox.
ALLOWED_ROOTS=

# Logging. Set DEBUG=true to include tracebacks in tool errors.
LOG_LEVEL=INFO
DEBUG=false

# Seconds before a kubectl invocation is aborted.
KUBECTL_TIMEOUT=120
